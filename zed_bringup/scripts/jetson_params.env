# Network configuration
export ROBOT_HOSTNAME=192.168.1.200
export JETSON_HOSTNAME=192.168.1.60
export JETSON_WORKSPACE=~/ros2_ws

# Camera 1 configuration
export JETSON_CAMERA_1_MODEL=zed2i
export JETSON_CAMERA_1_ID=top_rgbd_camera
export JETSON_CAMERA_1_DEVICE_ID=0

# Camera 2 configuration
export JETSON_CAMERA_2_MODEL=none
export JETSON_CAMERA_2_ID=rear_rgbd_camera
export JETSON_CAMERA_2_DEVICE_ID=1

export ROS_DOMAIN_ID=38
export RMW_IMPLEMENTATION=rmw_zenoh_cpp
export ZENOH_CONFIG_OVERRIDE='mode="client";connect/endpoints=["tcp/192.168.1.200:7447"]'
#export CYCLONEDDS_URI=file:///home/jetson/cyclonedds.xml
#export ZENOH_CONFIG_OVERRIDE="mode=\"client\";connect/endpoints=[\"tcp/${ROBOT_HOSTNAME}:7447\"]"

#export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
#export ROS_LOCALHOST_ONLY=1

#unset ZENOH_CONFIG_OVERRIDE
